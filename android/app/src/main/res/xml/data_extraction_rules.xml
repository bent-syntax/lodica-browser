<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device transfer. The vault key is bound to this device, so passwords survive a reinstall only through the passphrase-locked file the user exports in Settings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
