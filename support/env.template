# Lodica support desk settings. install.sh copies this to /etc/lodica-support.env (root only, mode 600).
# Placeholders only. Never put real values in this template or commit them.

# Support mailbox (SMTP sends, IMAP reads). The password is asked by install.sh.
SUPPORT_USER=lodica@syntaxya.be
SUPPORT_PASS=__ASKED_BY_INSTALL_SH__
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# Extra addresses that may answer tickets by mail (comma separated, optional)
SUPPORT_OWNERS=

SUPPORT_PORT=47610
SUPPORT_DATA=/var/lib/lodica-support

# Owner notification on every new ticket and follow-up
SUPPORT_NOTIFY_URL=http://127.0.0.1:47601/support/incoming
SUPPORT_NOTIFY_TOKEN=__BEARER_TOKEN_FOR_NOTIFY_URL__

# Google Task in the list "lodica" (credentials are read from ~/.lodica-tasks.json of the service user). 0 turns it off.
SUPPORT_TASKS_LIST=lodica
SUPPORT_TASKS=1

# Link with the relay: the relay posts in-app tickets here, answers go back through the relay admin API
SUPPORT_SECRET=__GENERATED_BY_INSTALL_SH__
SUPPORT_RELAY_URL=https://127.0.0.1:44741
SUPPORT_INSECURE_TLS=true
SUPPORT_RELAY_ADMIN_TOKEN_FILE=/etc/lodica-relay/support-admin-token
