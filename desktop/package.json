{
  "name": "lodica-desktop",
  "productName": "Lodica",
  "version": "1.14.10",
  "description": "Lodica browser for Windows",
  "author": "Lodica contributors",
  "license": "MIT",
  "main": "main/main.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "config": "node scripts/gen-config.js && node scripts/build-preload.js",
    "themes": "node scripts/build-themes.js",
    "icon": "node scripts/gen-icon.js",
    "start": "npm run config && electron .",
    "dist": "npm run config && npm run icon && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run config && npm run icon && electron-builder --linux AppImage deb --x64",
    "dist:flatpak": "npm run config && npm run icon && electron-builder --linux flatpak --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@ghostery/adblocker-electron": "2.18.2",
    "jsqr": "^1.4.0",
    "mammoth": "1.13.0"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "be.syntaxya.lodica",
    "productName": "Lodica",
    "copyright": "Lodica contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "pdf/**",
      "preload/**",
      "ui/**",
      "search/**",
      "config.json",
      "PATCH_NOTES.md",
      "package.json"
    ],
    "extraResources": [
      { "from": "../android/app/src/main/assets/extensions/helper/dict", "to": "dict" }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "signAndEditExecutable": true,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lodica",
      "artifactName": "Lodica-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Lodica-Portable-${version}.exe"
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "htm",
          "html"
        ],
        "name": "HTML document",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      },
      {
        "ext": "docx",
        "name": "Word document",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "SVG image",
        "role": "Viewer"
      }
    ],
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "finishArgs": ["--share=ipc", "--socket=x11", "--socket=wayland", "--socket=pulseaudio", "--share=network", "--device=dri", "--filesystem=xdg-download", "--talk-name=org.freedesktop.Notifications"]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Lodica contributors",
      "artifactName": "Lodica-${version}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "Lodica"
        }
      },
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/bent-syntax/lodica-browser",
  "desktopName": "lodica.desktop"
}
